{
  "name": "@songyanglin/dsh-sift",
  "description": "由 AI 协作的个人学习型知识梳理工作台",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/host/index.js",
  "types": "dist/types/host/index.d.ts",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client/index.js",
    "./package.json": "./package.json",
    "./typert": "./dist/host/typert.js",
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "knowledge-workbench"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "node scripts/dev.mjs start",
    "dev:clean": "node scripts/dev.mjs clean",
    "dev:setup": "node scripts/dev.mjs setup",
    "dev:status": "node scripts/dev.mjs status",
    "dev:workspace-profile": "node scripts/workspace-profile.mjs",
    "prepack": "pnpm check && pnpm test && pnpm build",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@milkdown/crepe": "^7.22.1",
    "@mozilla/readability": "0.6.0",
    "docx-preview": "^0.4.0",
    "dompurify": "3.4.15",
    "pdfjs-dist": "^6.3.289",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "19.2.8",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
